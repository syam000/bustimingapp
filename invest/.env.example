# Optional: a free Finnhub API key enables live quotes and symbol search.
# Get one at https://finnhub.io/register  (without it the app uses offline mock prices)
FINNHUB_API_KEY=your-key-here

# Port for the local web server (default 3100)
PORT=3100

# Set MOCK=1 to force offline mock prices even if a key is present
# MOCK=1
